{
  "schemaVersion": 1,
  "id": "community.ai-usage-dashboard",
  "name": "AI Usage Dashboard",
  "version": "0.1.0",
  "author": "Tyler South",
  "license": "MIT",
  "description": "Local token history, provider comparisons, and estimated API value.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AI Usage Dashboard",
    "description": "Local token history, provider comparisons, and estimated API value.",
    "category": "AI",
    "aliases": [
      "agents",
      "model-usage"
    ],
    "allowMultiple": false,
    "defaults": {
      "providers": {
        "codex": {
          "enabled": true
        },
        "claude": {
          "enabled": true
        },
        "opencode-go": {
          "enabled": true
        },
        "grok": {
          "enabled": true
        },
        "gemini": {
          "enabled": true
        },
        "opencode": {
          "enabled": true
        },
        "pi": {
          "enabled": true
        },
        "omp": {
          "enabled": true
        },
        "cursor": {
          "enabled": true
        }
      },
      "refreshIntervalSec": 900,
      "syncMode": "Off",
      "syncDir": "",
      "syncFileName": "",
      "syncDeviceId": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 900
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.agents"
  }
}
